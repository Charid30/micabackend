# Serveur
PORT=3000
NODE_ENV=development

# Base de données MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mica_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRES_IN=8h

# Scheduler publication (format cron: sec min heure jour mois jour_semaine)
# Par défaut: chaque vendredi à 06h00
PUBLICATION_CRON=0 0 6 * * 5

# PDF
PDF_OUTPUT_DIR=./storage/rapports

# Sauvegardes automatiques de la base (voir src/services/sauvegarde.service.js)
# Dossier des sauvegardes (relatif au dossier Backend ou chemin absolu) - hors du dossier web
SAUVEGARDE_DIR=storage/sauvegardes
# Copie hebdomadaire sur un autre disque ou partage reseau (fortement recommande), ex. D:\Sauvegardes\MICA
SAUVEGARDE_DIR_SECONDAIRE=
# Planification (sec min heure jour mois jour_semaine) : chaque nuit a 02h00
SAUVEGARDE_CRON=0 0 2 * * *
SAUVEGARDE_RETENTION_JOURS=30
SAUVEGARDE_HEBDO_SEMAINES=12
# Chemin de mysqldump (par defaut : C:\xampp\mysql\bin\mysqldump.exe sous Windows)
MYSQLDUMP_PATH=

# Double authentification : cle de chiffrement des secrets (64 caracteres hexadecimaux).
# A generer une fois : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne jamais la changer ensuite (les doubles authentifications existantes deviendraient illisibles).
TOTP_CLE_CHIFFREMENT=